# SmartContractRAG configuration
# Copy to .env and adjust. Never commit .env (it is gitignored).
# All values here are placeholders — no real credentials.

# Local LLM endpoint. This is the docker-network hostname for Ollama.
# IMPORTANT: inside the docker network we use "http://ollama:11434"
# (NOT "localhost") because Ollama does not expose a port to the host WSL.
OLLAMA_URL=http://ollama:11434

# Local LLM model used for answer generation.
OLLAMA_MODEL=qwen2.5-coder:7b

# Local embedding model (sentence-transformers).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Persistent vector store directory.
CHROMA_DIR=./data/chroma

# Corpus location (manifest lives at <CORPUS_DIR>/manifest.json).
CORPUS_DIR=./data/corpus

# Optional: default top-k retrieved chunks.
TOP_K=5
