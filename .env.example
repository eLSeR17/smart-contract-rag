# SmartContractRAG configuration
# Copy to .env and adjust. Never commit .env (it is gitignored).
# All values here are placeholders — no real credentials.

# Local LLM endpoint. This is the docker-network hostname for Ollama.
# IMPORTANT: inside the docker network we use "http://ollama:11434"
# (NOT "localhost") because Ollama does not expose a port to the host WSL.
OLLAMA_URL=http://ollama:11434

# Local LLM model used for answer generation.
OLLAMA_MODEL=qwen2.5-coder:7b

# Local embedding model (sentence-transformers).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Persistent vector store directory.
CHROMA_DIR=./data/chroma

# Corpus location (manifest lives at <CORPUS_DIR>/manifest.json).
CORPUS_DIR=./data/corpus

# Optional: default top-k retrieved chunks.
TOP_K=5

# Anti-hallucination grounding mode: "lexical" (default, deterministic, CI-safe)
# or "semantic" (experimental — NLI cross-encoder entailment; downloads ~250MB
# public distilbert MNLI model on first use; accepts answers logically entailed
# by the sources even when the phrasing differs from the chunks). NOTE: some NLI
# cross-encoders on the Hub are gated (login required) — this default is public.
GROUNDING_MODE=lexical
GROUNDING_MODEL=typeform/distilbert-base-uncased-mnli
GROUNDING_THRESHOLD=0.5

# --- REST API server (SmartContractRAG API) --------------------------------
# Only these four variables affect the HTTP server (src/smart_contract_rag/api.py).
#
# Auth mode: "none" (open, local dev) or "api_key" (X-API-Key required).
# Keys are created with: python scripts/create_api_key.py <name> [rate_per_min]
SCRAG_AUTH=none
# SQLite file backing the API-key store (hashed; see docs/API.md).
SCRAG_AUTH_DB=./auth.sqlite3
# Per-key requests per minute (token bucket).
SCRAG_RATE_LIMIT=60
# Max question length accepted by POST /query (characters).
SCRAG_MAX_QUESTION=4000
