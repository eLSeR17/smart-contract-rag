# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# Environments / secrets (NEVER commit)
.env
.env.local
.env.*.local

# Downloaded corpus (binary PDFs are large; the manifest is the committed source)
data/corpus/raw/*
!data/corpus/raw/.gitkeep
data/corpus/*.part

# Persistent vector stores
# NOTE: data/chroma/ is FORCE-ADDED to git (git add -f) so the free
# Streamlit Community Cloud deploy can run evidence-first without a
# build step. Re-run `git add -f data/chroma` if the index is rebuilt.
data/chroma/
*.chroma/

# Generated / runtime artifacts
data/embeddings_cache/
*.log
data/demo/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
