# SmartContractRAG — demo UI configuration (staging/demo_ui/.env.example)
# ---------------------------------------------------------------------------
# Copy to .env for reference, or set the variables in the shell that starts
# `streamlit run`. All values here are placeholders — never commit real keys.
#
# NOTE: Streamlit does NOT auto-load .env files. Export the variables in the
# shell, or use Streamlit secrets instead:
#   - local:            .streamlit/secrets.toml
#   - HF Spaces:        Settings -> Variables and secrets
# The app reads environment variables first, then Streamlit secrets.

# --- REST API mode (recommended; also the HF Spaces deployment mode) --------
# When SCRAG_API_URL is set, the Ask tab queries the deployed FastAPI server
# (docker compose -f docker-compose.prod.yml up -d --build exposes it on
# http://localhost:8000). Leave unset to use the embedded local mode.
SCRAG_API_URL=http://localhost:8000

# Required only when the API runs with SCRAG_AUTH=api_key (prod default).
SCRAG_API_KEY=replace-with-your-api-key

# --- Embedded mode (repository package + local Ollama) ----------------------
# Ollama endpoint. The default is the docker network hostname; change it to
# whatever the current host can reach (e.g. http://<host-ip>:11434).
OLLAMA_URL=http://ollama:11434

# Persistent ChromaDB store directory.
CHROMA_DIR=./data/chroma

# Corpus directory (manifest.json lives here).
CORPUS_DIR=./data/corpus

# Top-k retrieved chunks used by the pipeline.
TOP_K=5